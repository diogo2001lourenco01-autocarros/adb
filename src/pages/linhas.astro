---
import rawRoutes from "../../public/api/gtfs/routes.json";

interface RouteItem {
  id: string;
  short_name: string;
  long_name: string;
  color?: string;
  text_color?: string;
}

const routes: RouteItem[] = [...rawRoutes].sort((a, b) => {
  const numA = parseInt(a.short_name || a.id, 10);
  const numB = parseInt(b.short_name || b.id, 10);
  if (isNaN(numA) && isNaN(numB)) return (a.short_name || a.id).localeCompare(b.short_name || b.id);
  if (isNaN(numA)) return 1;
  if (isNaN(numB)) return -1;
  return numA - numB;
});

const diurnas = routes.filter(r => {
  const num = parseInt(r.short_name || r.id, 10);
  return !isNaN(num) && num < 900;
});

const noturnas = routes.filter(r => {
  const num = parseInt(r.short_name || r.id, 10);
  return !isNaN(num) && num >= 900;
});

const outras = routes.filter(r => {
  const num = parseInt(r.short_name || r.id, 10);
  return isNaN(num);
});
---
<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>AdB – Linhas e Paragens</title>
    <style>
      @font-face {
        font-family: 'DINBlack';
        src: url('/static/fonts/DINBlack.otf') format('opentype');
        font-weight: 900;
      }
      @font-face {
        font-family: 'DINMedium';
        src: url('/static/fonts/DINMedium.ttf') format('truetype');
        font-weight: 500;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        background-color: #0c0e14;
        color: #fff;
        font-family: 'DINMedium', Helvetica, Arial, sans-serif;
        display: flex;
        flex-direction: column;
      }

      /* ── HEADER ─────────────────────────────────────────────────── */
      header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15, 18, 25, 0.95);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        color: #fff;
      }
      .adb-logo {
        height: 28px;
        width: auto;
      }
      .brand-title {
        font-family: 'DINBlack';
        font-size: 18px;
        letter-spacing: 0.5px;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .nav-link {
        text-decoration: none;
        color: rgba(255, 255, 255, 0.65);
        font-size: 13px;
        padding: 6px 12px;
        border-radius: 6px;
        transition: background 0.15s, color 0.15s;
      }
      .nav-link:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
      }
      .nav-link.active {
        background: rgba(2, 124, 183, 0.2);
        color: #60b4f0;
        border: 1px solid rgba(2, 124, 183, 0.3);
      }

      /* ── MAIN CONTAINER ─────────────────────────────────────────── */
      main {
        max-width: 900px;
        width: 100%;
        margin: 0 auto;
        padding: 24px 16px 60px;
        flex: 1;
      }

      .page-header {
        margin-bottom: 24px;
      }
      .page-title {
        font-family: 'DINBlack';
        font-size: 28px;
        margin-bottom: 8px;
      }
      .page-desc {
        color: rgba(255, 255, 255, 0.6);
        font-size: 14px;
      }

      /* ── SEARCH BAR ─────────────────────────────────────────────── */
      .search-box {
        position: relative;
        margin-bottom: 28px;
      }
      .search-input {
        width: 100%;
        background: #151922;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 12px 16px 12px 42px;
        font-family: 'DINMedium', Helvetica, Arial, sans-serif;
        font-size: 15px;
        color: #fff;
        outline: none;
        transition: border-color 0.15s;
      }
      .search-input:focus {
        border-color: #027cb7;
      }
      .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255, 255, 255, 0.4);
        pointer-events: none;
      }

      /* ── CATEGORY SECTION ───────────────────────────────────────── */
      .category-section {
        margin-bottom: 32px;
      }
      .category-title {
        font-family: 'DINBlack';
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: rgba(255, 255, 255, 0.45);
        margin-bottom: 12px;
        padding-left: 4px;
      }

      .routes-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      /* ── ROUTE CARD ─────────────────────────────────────────────── */
      .route-card {
        background: #151922;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        overflow: hidden;
        transition: border-color 0.15s, background 0.15s;
      }
      .route-card:hover {
        border-color: rgba(255, 255, 255, 0.14);
      }
      .route-card.expanded {
        border-color: rgba(2, 124, 183, 0.4);
        background: #171c26;
      }

      .route-header {
        width: 100%;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 14px;
        background: none;
        border: none;
        color: inherit;
        text-align: left;
        cursor: pointer;
        font-family: inherit;
      }

      .route-badge {
        font-family: 'DINBlack';
        font-size: 14px;
        font-weight: 900;
        color: #fff;
        background: #027cb7;
        padding: 4px 10px;
        border-radius: 6px;
        min-width: 48px;
        text-align: center;
        flex-shrink: 0;
      }
      .route-badge.yellow {
        background: #ffc900;
        color: #000;
      }

      .route-names {
        flex: 1;
        min-width: 0;
      }
      .route-long-name {
        font-family: 'DINBlack';
        font-size: 15px;
        color: #fff;
        line-height: 1.3;
      }

      .chevron {
        color: rgba(255, 255, 255, 0.4);
        transition: transform 0.2s ease;
        flex-shrink: 0;
      }
      .route-card.expanded .chevron {
        transform: rotate(180deg);
        color: #60b4f0;
      }

      /* ── ROUTE DETAILS / STOPS ──────────────────────────────────── */
      .route-details {
        display: none;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        padding: 16px;
        background: rgba(12, 14, 20, 0.5);
      }
      .route-card.expanded .route-details {
        display: block;
      }

      .details-loading {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.5);
        padding: 12px 0;
        text-align: center;
      }

      /* ── DIRECTION SWITCHER ─────────────────────────────────────── */
      .dir-switch {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 18px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }
      .dir-tab-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 8px 14px;
        color: rgba(255, 255, 255, 0.7);
        font-family: 'DINMedium', Helvetica, Arial, sans-serif;
        font-size: 13px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.15s ease;
      }
      .dir-tab-btn:hover {
        background: rgba(255, 255, 255, 0.09);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.2);
      }
      .dir-tab-btn.active {
        background: rgba(2, 124, 183, 0.22);
        color: #60b4f0;
        border-color: rgba(2, 124, 183, 0.5);
        font-family: 'DINBlack', Helvetica, Arial, sans-serif;
      }
      .dir-tab-badge {
        font-size: 11px;
        background: rgba(0, 0, 0, 0.35);
        padding: 2px 7px;
        border-radius: 12px;
        color: rgba(255, 255, 255, 0.65);
        font-family: 'DINMedium', sans-serif;
      }
      .dir-tab-btn.active .dir-tab-badge {
        background: rgba(2, 124, 183, 0.4);
        color: #fff;
      }

      /* ── TRANSIT SPINE (ESPINHA DE PARAGENS) ────────────────────── */
      .spine-container {
        position: relative;
        padding: 4px 0 12px;
      }

      /* Vertical continuous line */
      .spine-rail {
        position: absolute;
        left: 17px;
        top: 20px;
        bottom: 20px;
        width: 3px;
        background: linear-gradient(180deg, #027cb7 0%, #0290d4 70%, #22c55e 100%);
        border-radius: 2px;
        z-index: 1;
      }

      .spine-stops-list {
        display: flex;
        flex-direction: column;
        gap: 0;
        position: relative;
        z-index: 2;
      }

      .spine-stop-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 8px 6px;
        border-radius: 8px;
        transition: background 0.15s ease;
      }
      .spine-stop-row:hover {
        background: rgba(255, 255, 255, 0.04);
      }

      /* Node icon wrap (covers rail cleanly) */
      .spine-node-wrap {
        width: 26px;
        height: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #171c26; /* match expanded card bg */
        border-radius: 50%;
      }

      /* Terminal Partida (Origin) */
      .spine-node-terminal-start {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #027cb7;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        box-shadow: 0 0 0 3px rgba(2, 124, 183, 0.25);
      }

      /* Paragem Intermédia */
      .spine-node-intermediate {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #171c26;
        border: 2.5px solid #027cb7;
        transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
      }
      .spine-stop-row:hover .spine-node-intermediate {
        background: #60b4f0;
        border-color: #60b4f0;
        transform: scale(1.3);
      }

      /* Terminal Término (Destination) */
      .spine-node-terminal-end {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #22c55e;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25);
      }

      /* Stop information */
      .spine-info {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .spine-name-group {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        flex-wrap: wrap;
      }

      .spine-name {
        font-family: 'DINMedium', Helvetica, Arial, sans-serif;
        font-size: 14px;
        color: rgba(255, 255, 255, 0.88);
        letter-spacing: 0.2px;
      }
      .spine-stop-row.is-terminal .spine-name {
        font-family: 'DINBlack', Helvetica, Arial, sans-serif;
        color: #fff;
        font-size: 14.5px;
      }

      /* Badges */
      .spine-badges {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
      }

      .stop-code-badge {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 5px;
        padding: 2px 7px;
        font-family: 'DINBlack', monospace;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.85);
        letter-spacing: 0.4px;
      }
      .stop-code-badge .prefix {
        color: rgba(255, 255, 255, 0.35);
        font-size: 10px;
        font-family: monospace;
      }

      .terminal-pill {
        font-family: 'DINBlack', sans-serif;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 2px 8px;
        border-radius: 4px;
      }
      .terminal-pill.start {
        background: rgba(2, 124, 183, 0.2);
        color: #60b4f0;
        border: 1px solid rgba(2, 124, 183, 0.35);
      }
      .terminal-pill.end {
        background: rgba(34, 197, 94, 0.18);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.35);
      }

      .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: rgba(255, 255, 255, 0.4);
        font-size: 14px;
        display: none;
      }
    </style>
  </head>
  <body>

    <!-- ── HEADER ───────────────────────────────────────────────── -->
    <header>
      <a href="/" class="brand">
        <img src="/static/images/adb.svg" alt="AdB Logo" class="adb-logo" />
        <span class="brand-title">Linhas</span>
      </a>
      <nav class="nav-links">
        <a href="/" class="nav-link">Início</a>
        <a href="/mapa" class="nav-link">Mapa Live</a>
        <a href="/linhas" class="nav-link active">Linhas</a>
      </nav>
    </header>

    <!-- ── MAIN ─────────────────────────────────────────────────── -->
    <main>
      <div class="page-header">
        <h1 class="page-title">Linhas e Paragens</h1>
        <p class="page-desc">Consulte o itinerário, sentidos e lista de paragens de todas as linhas dos TUB.</p>
      </div>

      <!-- ── SEARCH BAR ─────────────────────────────────────────── -->
      <div class="search-box">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" id="route-search" class="search-input" placeholder="Pesquisar por número de linha ou destino (ex: 2, 40, Bom Jesus)..." />
      </div>

      <div id="empty-results" class="empty-state">
        Nenhuma linha encontrada para o termo pesquisado.
      </div>

      <!-- ── DIURNAS ────────────────────────────────────────────── -->
      {diurnas.length > 0 && (
        <section class="category-section" data-section="diurnas">
          <h2 class="category-title">Linhas Diurnas</h2>
          <div class="routes-list">
            {diurnas.map((route) => (
              <div class="route-card" data-route-id={route.id} data-search={`${route.short_name} ${route.long_name}`.toLowerCase()}>
                <button class="route-header" type="button" aria-expanded="false">
                  <span class="route-badge">{route.short_name || route.id}</span>
                  <div class="route-names">
                    <div class="route-long-name">{route.long_name}</div>
                  </div>
                  <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="route-details" id={`details-${route.id}`}>
                  <div class="details-loading">A carregar paragens...</div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- ── NOTURNAS ───────────────────────────────────────────── -->
      {noturnas.length > 0 && (
        <section class="category-section" data-section="noturnas">
          <h2 class="category-title">Linhas Noturnas</h2>
          <div class="routes-list">
            {noturnas.map((route) => (
              <div class="route-card" data-route-id={route.id} data-search={`${route.short_name} ${route.long_name}`.toLowerCase()}>
                <button class="route-header" type="button" aria-expanded="false">
                  <span class="route-badge">{route.short_name || route.id}</span>
                  <div class="route-names">
                    <div class="route-long-name">{route.long_name}</div>
                  </div>
                  <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="route-details" id={`details-${route.id}`}>
                  <div class="details-loading">A carregar paragens...</div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- ── OUTRAS ─────────────────────────────────────────────── -->
      {outras.length > 0 && (
        <section class="category-section" data-section="outras">
          <h2 class="category-title">Outras Linhas</h2>
          <div class="routes-list">
            {outras.map((route) => (
              <div class="route-card" data-route-id={route.id} data-search={`${route.short_name} ${route.long_name}`.toLowerCase()}>
                <button class="route-header" type="button" aria-expanded="false">
                  <span class="route-badge">{route.short_name || route.id}</span>
                  <div class="route-names">
                    <div class="route-long-name">{route.long_name}</div>
                  </div>
                  <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="route-details" id={`details-${route.id}`}>
                  <div class="details-loading">A carregar paragens...</div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}
    </main>

    <script is:inline>
      const loadedRouteData = new Map();

      // Accordion toggle & fetch route details
      document.addEventListener('click', async (e) => {
        const headerBtn = e.target.closest('.route-header');
        if (!headerBtn) return;

        const card = headerBtn.closest('.route-card');
        const routeId = card.getAttribute('data-route-id');
        const isExpanded = card.classList.contains('expanded');

        if (isExpanded) {
          card.classList.remove('expanded');
          headerBtn.setAttribute('aria-expanded', 'false');
          return;
        }

        // Expand
        card.classList.add('expanded');
        headerBtn.setAttribute('aria-expanded', 'true');

        const detailsEl = card.querySelector('.route-details');

        // Check if already fetched
        if (loadedRouteData.has(routeId)) {
          renderRouteDetails(detailsEl, loadedRouteData.get(routeId));
          return;
        }

        try {
          const res = await fetch(`/api/gtfs/routes/${routeId}.json`);
          if (!res.ok) throw new Error('Não foi possível carregar os detalhes da linha');
          const data = await res.json();
          loadedRouteData.set(routeId, data);
          renderRouteDetails(detailsEl, data);
        } catch (err) {
          detailsEl.innerHTML = `<div class="details-loading" style="color:#ef4444;">Erro ao carregar paragens: ${err.message}</div>`;
        }
      });

      function renderRouteDetails(container, data) {
        if (!data || !data.directions || data.directions.length === 0) {
          container.innerHTML = `<div class="details-loading">Nenhuma informação de paragens disponível.</div>`;
          return;
        }

        const directions = data.directions;
        let activeDir = 0;

        function renderSpine() {
          let html = '';

          // If multiple directions, show direction switcher tabs
          if (directions.length > 1) {
            html += '<div class="dir-switch">';
            directions.forEach((d, idx) => {
              const title = d.headsign ? d.headsign : (idx === 0 ? 'Sentido A' : 'Sentido B');
              const count = d.stops ? d.stops.length : 0;
              html += `
                <button type="button" class="dir-tab-btn ${idx === activeDir ? 'active' : ''}" data-dir-index="${idx}">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                  </svg>
                  <span>Sentido: <strong>${title}</strong></span>
                  <span class="dir-tab-badge">${count} paragens</span>
                </button>
              `;
            });
            html += '</div>';
          }

          const currentDir = directions[activeDir] || directions[0];
          const stops = currentDir.stops || [];

          if (stops.length === 0) {
            html += '<div class="details-loading">Sem paragens registadas para este sentido.</div>';
            container.innerHTML = html;
            bindDirEvents();
            return;
          }

          html += '<div class="spine-container">';
          html += '<div class="spine-rail"></div>';
          html += '<div class="spine-stops-list">';

          stops.forEach((stop, index) => {
            const isFirst = index === 0;
            const isLast = index === stops.length - 1;
            const isTerminal = isFirst || isLast;
            const stopCode = stop.code || stop.id;

            let nodeHtml = '';
            let terminalTag = '';

            if (isFirst) {
              nodeHtml = `
                <div class="spine-node-terminal-start" title="Terminal de Partida">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                    <circle cx="12" cy="12" r="6"></circle>
                  </svg>
                </div>
              `;
              terminalTag = '<span class="terminal-pill start">Partida</span>';
            } else if (isLast) {
              nodeHtml = `
                <div class="spine-node-terminal-end" title="Terminal de Chegada">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
                    <line x1="4" y1="22" x2="4" y2="15"></line>
                  </svg>
                </div>
              `;
              terminalTag = '<span class="terminal-pill end">Término</span>';
            } else {
              nodeHtml = '<div class="spine-node-intermediate" title="Paragem Intermédia"></div>';
            }

            html += `
              <div class="spine-stop-row ${isTerminal ? 'is-terminal' : 'is-intermediate'}">
                <div class="spine-node-wrap">
                  ${nodeHtml}
                </div>
                <div class="spine-info">
                  <div class="spine-name-group">
                    <span class="spine-name">${stop.name}</span>
                    ${terminalTag}
                  </div>
                  <div class="spine-badges">
                    ${stopCode ? `<span class="stop-code-badge"><span class="prefix">#</span>${stopCode}</span>` : ''}
                  </div>
                </div>
              </div>
            `;
          });

          html += '</div></div>';
          container.innerHTML = html;
          bindDirEvents();
        }

        function bindDirEvents() {
          container.querySelectorAll('.dir-tab-btn').forEach(btn => {
            btn.addEventListener('click', (ev) => {
              ev.stopPropagation();
              activeDir = parseInt(btn.getAttribute('data-dir-index'), 10) || 0;
              renderSpine();
            });
          });
        }

        renderSpine();
      }

      // Search filtering
      const searchInput = document.getElementById('route-search');
      const emptyState = document.getElementById('empty-results');

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          const query = searchInput.value.trim().toLowerCase();
          const cards = document.querySelectorAll('.route-card');
          let visibleCount = 0;

          cards.forEach(card => {
            const searchText = card.getAttribute('data-search') || '';
            const matches = !query || searchText.includes(query);
            card.style.display = matches ? '' : 'none';
            if (matches) visibleCount++;
          });

          // Toggle category headers if their children are all hidden
          document.querySelectorAll('.category-section').forEach(sec => {
            const hasVisible = Array.from(sec.querySelectorAll('.route-card')).some(c => c.style.display !== 'none');
            sec.style.display = hasVisible ? '' : 'none';
          });

          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        });
      }
    </script>
  </body>
</html>

