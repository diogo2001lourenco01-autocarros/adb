---
import rawRoutes from "../../public/api/gtfs/routes.json";

interface RouteItem {
  id: string;
  short_name: string;
  long_name: string;
  color?: string;
  text_color?: string;
}

const routes: RouteItem[] = [...rawRoutes].sort((a, b) => {
  const numA = parseInt(a.short_name || a.id, 10);
  const numB = parseInt(b.short_name || b.id, 10);
  if (isNaN(numA) && isNaN(numB)) return (a.short_name || a.id).localeCompare(b.short_name || b.id);
  if (isNaN(numA)) return 1;
  if (isNaN(numB)) return -1;
  return numA - numB;
});

const diurnas = routes.filter(r => {
  const num = parseInt(r.short_name || r.id, 10);
  return !isNaN(num) && num < 900;
});

const noturnas = routes.filter(r => {
  const num = parseInt(r.short_name || r.id, 10);
  return !isNaN(num) && num >= 900;
});

const outras = routes.filter(r => {
  const num = parseInt(r.short_name || r.id, 10);
  return isNaN(num);
});
---
<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>AdB – Linhas e Paragens</title>
    <style>
      @font-face {
        font-family: 'DINBlack';
        src: url('/static/fonts/DINBlack.otf') format('opentype');
        font-weight: 900;
      }
      @font-face {
        font-family: 'DINMedium';
        src: url('/static/fonts/DINMedium.ttf') format('truetype');
        font-weight: 500;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        background-color: #0c0e14;
        color: #fff;
        font-family: 'DINMedium', Helvetica, Arial, sans-serif;
        display: flex;
        flex-direction: column;
      }

      /* ── HEADER ─────────────────────────────────────────────────── */
      header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15, 18, 25, 0.95);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        color: #fff;
      }
      .adb-logo {
        height: 28px;
        width: auto;
      }
      .brand-title {
        font-family: 'DINBlack';
        font-size: 18px;
        letter-spacing: 0.5px;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .nav-link {
        text-decoration: none;
        color: rgba(255, 255, 255, 0.65);
        font-size: 13px;
        padding: 6px 12px;
        border-radius: 6px;
        transition: background 0.15s, color 0.15s;
      }
      .nav-link:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
      }
      .nav-link.active {
        background: rgba(2, 124, 183, 0.2);
        color: #60b4f0;
        border: 1px solid rgba(2, 124, 183, 0.3);
      }

      /* ── MAIN CONTAINER ─────────────────────────────────────────── */
      main {
        max-width: 900px;
        width: 100%;
        margin: 0 auto;
        padding: 24px 16px 60px;
        flex: 1;
      }

      .page-header {
        margin-bottom: 24px;
      }
      .page-title {
        font-family: 'DINBlack';
        font-size: 28px;
        margin-bottom: 8px;
      }
      .page-desc {
        color: rgba(255, 255, 255, 0.6);
        font-size: 14px;
      }

      /* ── SEARCH BAR ─────────────────────────────────────────────── */
      .search-box {
        position: relative;
        margin-bottom: 28px;
      }
      .search-input {
        width: 100%;
        background: #151922;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 12px 16px 12px 42px;
        font-family: 'DINMedium', Helvetica, Arial, sans-serif;
        font-size: 15px;
        color: #fff;
        outline: none;
        transition: border-color 0.15s;
      }
      .search-input:focus {
        border-color: #027cb7;
      }
      .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255, 255, 255, 0.4);
        pointer-events: none;
      }

      /* ── CATEGORY SECTION ───────────────────────────────────────── */
      .category-section {
        margin-bottom: 32px;
      }
      .category-title {
        font-family: 'DINBlack';
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: rgba(255, 255, 255, 0.45);
        margin-bottom: 12px;
        padding-left: 4px;
      }

      .routes-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      /* ── ROUTE CARD ─────────────────────────────────────────────── */
      .route-card {
        background: #151922;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        overflow: hidden;
        transition: border-color 0.15s, background 0.15s;
      }
      .route-card:hover {
        border-color: rgba(255, 255, 255, 0.14);
      }
      .route-card.expanded {
        border-color: rgba(2, 124, 183, 0.4);
        background: #171c26;
      }

      .route-header {
        width: 100%;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 14px;
        background: none;
        border: none;
        color: inherit;
        text-align: left;
        cursor: pointer;
        font-family: inherit;
      }

      .route-badge {
        font-family: 'DINBlack';
        font-size: 14px;
        font-weight: 900;
        color: #fff;
        background: #027cb7;
        padding: 4px 10px;
        border-radius: 6px;
        min-width: 48px;
        text-align: center;
        flex-shrink: 0;
      }
      .route-badge.yellow {
        background: #ffc900;
        color: #000;
      }

      .route-names {
        flex: 1;
        min-width: 0;
      }
      .route-long-name {
        font-family: 'DINBlack';
        font-size: 15px;
        color: #fff;
        line-height: 1.3;
      }

      .chevron {
        color: rgba(255, 255, 255, 0.4);
        transition: transform 0.2s ease;
        flex-shrink: 0;
      }
      .route-card.expanded .chevron {
        transform: rotate(180deg);
        color: #60b4f0;
      }

      /* ── ROUTE DETAILS / STOPS ──────────────────────────────────── */
      .route-details {
        display: none;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        padding: 16px;
        background: rgba(12, 14, 20, 0.5);
      }
      .route-card.expanded .route-details {
        display: block;
      }

      .details-loading {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.5);
        padding: 12px 0;
        text-align: center;
      }

      .direction-block {
        margin-bottom: 20px;
      }
      .direction-block:last-child {
        margin-bottom: 0;
      }
      .direction-header {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'DINBlack';
        font-size: 13px;
        color: #60b4f0;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .stops-timeline {
        position: relative;
        padding-left: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .stops-timeline::before {
        content: '';
        position: absolute;
        left: 5px;
        top: 6px;
        bottom: 6px;
        width: 2px;
        background: rgba(2, 124, 183, 0.35);
      }

      .stop-item {
        position: relative;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.85);
        line-height: 1.4;
      }
      .stop-item::before {
        content: '';
        position: absolute;
        left: -18px;
        top: 5px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #027cb7;
        box-shadow: 0 0 0 2px #0c0e14;
      }
      .stop-item:first-child::before,
      .stop-item:last-child::before {
        width: 8px;
        height: 8px;
        left: -19px;
        top: 4px;
        background: #60b4f0;
      }
      .stop-code {
        color: rgba(255, 255, 255, 0.4);
        font-size: 11px;
        margin-left: 6px;
      }

      .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: rgba(255, 255, 255, 0.4);
        font-size: 14px;
        display: none;
      }
    </style>
  </head>
  <body>

    <!-- ── HEADER ───────────────────────────────────────────────── -->
    <header>
      <a href="/" class="brand">
        <img src="/static/images/adb.svg" alt="AdB Logo" class="adb-logo" />
        <span class="brand-title">Linhas</span>
      </a>
      <nav class="nav-links">
        <a href="/" class="nav-link">Início</a>
        <a href="/mapa" class="nav-link">Mapa Live</a>
        <a href="/linhas" class="nav-link active">Linhas</a>
      </nav>
    </header>

    <!-- ── MAIN ─────────────────────────────────────────────────── -->
    <main>
      <div class="page-header">
        <h1 class="page-title">Linhas e Paragens</h1>
        <p class="page-desc">Consulte o itinerário, sentidos e lista de paragens de todas as linhas dos TUB.</p>
      </div>

      <!-- ── SEARCH BAR ─────────────────────────────────────────── -->
      <div class="search-box">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" id="route-search" class="search-input" placeholder="Pesquisar por número de linha ou destino (ex: 2, 40, Bom Jesus)..." />
      </div>

      <div id="empty-results" class="empty-state">
        Nenhuma linha encontrada para o termo pesquisado.
      </div>

      <!-- ── DIURNAS ────────────────────────────────────────────── -->
      {diurnas.length > 0 && (
        <section class="category-section" data-section="diurnas">
          <h2 class="category-title">Linhas Diurnas</h2>
          <div class="routes-list">
            {diurnas.map((route) => (
              <div class="route-card" data-route-id={route.id} data-search={`${route.short_name} ${route.long_name}`.toLowerCase()}>
                <button class="route-header" type="button" aria-expanded="false">
                  <span class="route-badge">{route.short_name || route.id}</span>
                  <div class="route-names">
                    <div class="route-long-name">{route.long_name}</div>
                  </div>
                  <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="route-details" id={`details-${route.id}`}>
                  <div class="details-loading">A carregar paragens...</div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- ── NOTURNAS ───────────────────────────────────────────── -->
      {noturnas.length > 0 && (
        <section class="category-section" data-section="noturnas">
          <h2 class="category-title">Linhas Noturnas</h2>
          <div class="routes-list">
            {noturnas.map((route) => (
              <div class="route-card" data-route-id={route.id} data-search={`${route.short_name} ${route.long_name}`.toLowerCase()}>
                <button class="route-header" type="button" aria-expanded="false">
                  <span class="route-badge">{route.short_name || route.id}</span>
                  <div class="route-names">
                    <div class="route-long-name">{route.long_name}</div>
                  </div>
                  <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="route-details" id={`details-${route.id}`}>
                  <div class="details-loading">A carregar paragens...</div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- ── OUTRAS ─────────────────────────────────────────────── -->
      {outras.length > 0 && (
        <section class="category-section" data-section="outras">
          <h2 class="category-title">Outras Linhas</h2>
          <div class="routes-list">
            {outras.map((route) => (
              <div class="route-card" data-route-id={route.id} data-search={`${route.short_name} ${route.long_name}`.toLowerCase()}>
                <button class="route-header" type="button" aria-expanded="false">
                  <span class="route-badge">{route.short_name || route.id}</span>
                  <div class="route-names">
                    <div class="route-long-name">{route.long_name}</div>
                  </div>
                  <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
                <div class="route-details" id={`details-${route.id}`}>
                  <div class="details-loading">A carregar paragens...</div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}
    </main>

    <script is:inline>
      const loadedRouteData = new Map();

      // Accordion toggle & fetch route details
      document.addEventListener('click', async (e) => {
        const headerBtn = e.target.closest('.route-header');
        if (!headerBtn) return;

        const card = headerBtn.closest('.route-card');
        const routeId = card.getAttribute('data-route-id');
        const isExpanded = card.classList.contains('expanded');

        if (isExpanded) {
          card.classList.remove('expanded');
          headerBtn.setAttribute('aria-expanded', 'false');
          return;
        }

        // Expand
        card.classList.add('expanded');
        headerBtn.setAttribute('aria-expanded', 'true');

        const detailsEl = card.querySelector('.route-details');

        // Check if already fetched
        if (loadedRouteData.has(routeId)) {
          renderRouteDetails(detailsEl, loadedRouteData.get(routeId));
          return;
        }

        try {
          const res = await fetch(`/api/gtfs/routes/${routeId}.json`);
          if (!res.ok) throw new Error('Não foi possível carregar os detalhes da linha');
          const data = await res.json();
          loadedRouteData.set(routeId, data);
          renderRouteDetails(detailsEl, data);
        } catch (err) {
          detailsEl.innerHTML = `<div class="details-loading" style="color:#ef4444;">Erro ao carregar paragens: ${err.message}</div>`;
        }
      });

      function renderRouteDetails(container, data) {
        if (!data || !data.directions || data.directions.length === 0) {
          container.innerHTML = `<div class="details-loading">Nenhuma informação de paragens disponível.</div>`;
          return;
        }

        const directionsHtml = data.directions.map((dir, idx) => {
          const headsign = dir.headsign ? `Sentido: ${dir.headsign}` : `Sentido ${idx === 0 ? 'A' : 'B'}`;
          const stopsHtml = dir.stops && dir.stops.length > 0
            ? dir.stops.map(s => `
                <div class="stop-item">
                  <span>${s.name}</span>
                  ${s.id ? `<span class="stop-code">#${s.id}</span>` : ''}
                </div>
              `).join('')
            : '<div style="font-size:12px;color:rgba(255,255,255,0.4);">Sem paragens registadas.</div>';

          return `
            <div class="direction-block">
              <div class="direction-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 16 16 12 12 8"></polyline>
                  <line x1="8" y1="12" x2="16" y2="12"></line>
                </svg>
                ${headsign}
              </div>
              <div class="stops-timeline">
                ${stopsHtml}
              </div>
            </div>
          `;
        }).join('');

        container.innerHTML = directionsHtml;
      }

      // Search filtering
      const searchInput = document.getElementById('route-search');
      const emptyState = document.getElementById('empty-results');

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          const query = searchInput.value.trim().toLowerCase();
          const cards = document.querySelectorAll('.route-card');
          let visibleCount = 0;

          cards.forEach(card => {
            const searchText = card.getAttribute('data-search') || '';
            const matches = !query || searchText.includes(query);
            card.style.display = matches ? '' : 'none';
            if (matches) visibleCount++;
          });

          // Toggle category headers if their children are all hidden
          document.querySelectorAll('.category-section').forEach(sec => {
            const hasVisible = Array.from(sec.querySelectorAll('.route-card')).some(c => c.style.display !== 'none');
            sec.style.display = hasVisible ? '' : 'none';
          });

          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        });
      }
    </script>
  </body>
</html>

