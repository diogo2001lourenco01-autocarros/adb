---
import { getRoutesWithStops } from "../lib/gtfs";

// Load routes with stops at build time
const routes = await getRoutesWithStops();
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Linhas</title>
  <style>
    .stop-list { display: none; margin-left: 1rem; }
    .route { margin-bottom: 1rem; }
    .toggle-btn { cursor: pointer; color: blue; text-decoration: underline; }
  </style>
</head>
<body>
  <h1>Linhas</h1>
  {routes.length === 0 && (
    <p>No routes found in GTFS data.</p>
  )}
  <ul>
    {routes.map((route) => (
      <li class="route" id={`route-${route.route_id}`}>
        <span class="toggle-btn" data-route-id="{route.route_id}">
          {route.short_name || route.long_name || route.route_id}
        </span>
        <div class="stop-list" id={`stops-${route.route_id}`}>
          {route.stops.length === 0 ? (
            <p>No stops for this route.</p>
          ) : (
            <ul>
              {route.stops.map((stop) => (
                <li>
                  {stop.name}
                  {stop.code ? ` (Code: ${stop.code})` : ""}
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ul>
  <script>
    // Simple toggle functionality for each route
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (target && target.matches('.toggle-btn')) {
        const routeId = target.getAttribute('data-route-id');
        const list = document.getElementById(`stops-${routeId}`);
        if (list) {
          list.style.display = list.style.display === 'none' ? 'block' : 'none';
        }
      }
    });
  </script>
</body>
</html>
